<?xml version="1.0" encoding="utf-8"?>
<!-- Crystal glass tile. Focused: the tile itself brightens with a bright rim, so the selection is exactly
     the tile's size and shape (the floating highlight is off). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="140" android:exitFadeDuration="180">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#8CFFFFFF" android:centerColor="#4DFFFFFF" android:endColor="#33FFFFFF" />
                <corners android:radius="16dp" /></shape></item>
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="48dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" /></shape></item>
            <item><shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <stroke android:width="2dp" android:color="#FFFFFFFF" />
                <corners android:radius="16dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#0AFFFFFF" />
                <corners android:radius="16dp" /></shape></item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="48dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#00FFFFFF" />
                <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" /></shape></item>
            <item><shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <stroke android:width="1dp" android:color="#80FFFFFF" />
                <corners android:radius="16dp" /></shape></item>
        </layer-list>
    </item>
</selector>
