<?xml version="1.0" encoding="utf-8"?>
<!-- Crystal glass pills: clear with a light rim and a top sheen; focused, brighter glass with a bright rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#B3FFFFFF" />
                <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
                <corners android:radius="21dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#0AFFFFFF" />
                <stroke android:width="1dp" android:color="#73FFFFFF" />
                <corners android:radius="21dp" /></shape></item>
            <item android:left="2dp" android:right="2dp" android:top="1dp" android:bottom="22dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" /></shape></item>
        </layer-list>
    </item>
</selector>
